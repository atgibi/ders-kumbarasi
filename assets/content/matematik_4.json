T.4.1.5#2"},{"type":"mc","prompt":"100, 90, 80, 70, … Bu örüntünün 8. adımı kaçtır?","options":["30","20","10"],"answer":0,"id":"MAT.4.1.5#3"},{"type":"mc","prompt":"Her adımda 3 kibrit eklenerek üçgenler yapılıyor. 5 üçgen için kaç kibrit gerekir?","options":["12","15","8"],"answer":1,"id":"MAT.4.1.5#4"}]},{"kod":"MAT.4.1.6","lessons":[{"title":"Kesir çeşitleri","pages":[{"text":"Payı paydasından küçük olan kesirler basit kesirdir: 3/5.","visual":{"kind":"fraction","parts":5,"shaded":3}},{"text":"Payı paydasına eşit ya da büyük olan kesirler bileşik kesirdir: 7/4. Bunu 1 tam 3/4 diye tam sayılı kesir olarak da yazabiliriz.","visual":{"kind":"text","text":"7/4 = 1 3/4"}}],"id":"MAT.4.1.6/L1"}],"cards":[{"type":"mc","prompt":"Hangisi basit kesirdir?","options":["3/5","5/3","4/4"],"answer":0,"id":"MAT.4.1.6#1"},{"type":"mc","prompt":"Hangisi bileşik kesirdir?","options":["2/7","9/4","1/3"],"answer":1,"id":"MAT.4.1.6#2"},{"type":"mc","prompt":"5/2 kesri tam sayılı kesir olarak nasıl yazılır?","options":["2 tam 1/2","1 tam 2/5","5 tam 1/2"],"answer":0,"id":"MAT.4.1.6#3"},{"type":"mc","prompt":"1 tam 1/4 hangi bileşik kesre eşittir?","options":["5/4","4/5","2/4"],"answer":0,"id":"MAT.4.1.6#4"},{"type":"gen","gen":"fraction_read","params":{"parts":[3,4,5,6,8]},"id":"MAT.4.1.6#5"}]},{"kod":"MAT.4.1.7","lessons":[{"title":"Denk kesirler","pages":[{"text":"1/2 ile 2/4 aynı büyüklüktedir. Bunlara denk kesirler denir.","visual":{"kind":"fraction","parts":4,"shaded":2}},{"text":"Pay ve paydayı aynı sayıyla çarparsak denk kesir buluruz: 1/3 = 2/6 = 3/9.","visual":{"kind":"text","text":"1/3 = 2/6 = 3/9"}}],"id":"MAT.4.1.7/L1"}],"cards":[{"type":"mc","prompt":"1/2 kesrine denk olan hangisidir?","options":["2/4","2/3","1/4"],"answer":0,"id":"MAT.4.1.7#1"},{"type":"mc","prompt":"2/3 kesrine denk olan hangisidir?","options":["4/6","3/2","2/6"],"answer":0,"id":"MAT.4.1.7#2"},{"type":"mc","prompt":"3/4 = ☐/8 Kutuya hangi sayı gelir?","options":["3","6","4"],"answer":1,"id":"MAT.4.1.7#3"},{"type":"mc","prompt":"Hangisi 1/5 kesrine denk değildir?","options":["2/10","3/15","5/10"],"answer":2,"id":"MAT.4.1.7#4"}]},{"kod":"MAT.4.1.8","lessons":[{"title":"Birim kesirleri karşılaştırma","pages":[{"text":"Payı 1 olan kesirlerde payda büyüdükçe parça küçülür: 1/2 > 1/4 > 1/8.","visual":{"kind":"fraction","parts":8,"shaded":1}}],"id":"MAT.4.1.8/L1"}],"cards":[{"type":"gen","gen":"fraction_compare","params":{"unit":true},"id":"MAT.4.1.8#1"},{"type":"gen","gen":"fraction_compare","params":{"unit":true},"id":"MAT.4.1.8#2"},{"type":"mc","prompt":"Küçükten büyüğe sıralı olan hangisidir?","options":["1/9, 1/5, 1/2","1/2, 1/5, 1/9","1/5, 1/2, 1/9"],"answer":0,"id":"MAT.4.1.8#3"}]},{"kod":"MAT.4.1.9","lessons":[{"title":"Paydaları eşit kesirler","pages":[{"text":"Paydaları eşit kesirlerde payı büyük olan daha büyüktür: 5/8 > 3/8.","visual":{"kind":"fraction","parts":8,"shaded":5}}],"id":"MAT.4.1.9/L1"}],"cards":[{"type":"gen","gen":"fraction_compare","params":{},"id":"MAT.4.1.9#1"},{"type":"gen","gen":"fraction_compare","params":{},"id":"MAT.4.1.9#2"},{"type":"mc","prompt":"Büyükten küçüğe sıralı olan hangisidir?","options":["7/10, 4/10, 1/10","1/10, 4/10, 7/10"],"answer":0,"id":"MAT.4.1.9#3"}]},{"kod":"MAT.4.1.10","lessons":[{"title":"Bir çokluğun kesri","pages":[{"text":"12 şekerin 1/3'ünü bulmak için 12'yi 3 eş gruba ayırırız: her grupta 4 şeker.","visual":{"kind":"groups","emoji":"🍬","groups":3,"each":4}},{"text":"12'nin 2/3'ü ise iki grup eder: 8 şeker.","visual":{"kind":"text","text":"12 ÷ 3 × 2 = 8"}}],"id":"MAT.4.1.10/L1"}],"cards":[{"type":"gen","gen":"fraction_of_set","params":{"unit":true},"id":"MAT.4.1.10#1"},{"type":"gen","gen":"fraction_of_set","params":{},"id":"MAT.4.1.10#2"},{"type":"gen","gen":"fraction_of_set","params":{"d_max":10,"k_max":10},"id":"MAT.4.1.10#3"},{"type":"mc","prompt":"Bir sınıfın 1/4'ü 6 kişi ise sınıf mevcudu kaçtır?","options":["10","24","30"],"answer":1,"id":"MAT.4.1.10#4"},{"type":"mc","prompt":"40 sayfalık kitabın 3/4'ünü okudum. Kaç sayfa okudum?","options":["10","30","34"],"answer":1,"id":"MAT.4.1.10#5"}]},{"kod":"MAT.4.1.11","lessons":[{"title":"Kesirlerle toplama ve çıkarma","pages":[{"text":"Paydaları eşit kesirleri toplarken payları toplarız, paydayı aynen yazarız: 2/7 + 3/7 = 5/7.","visual":{"kind":"text","text":"2/7 + 3/7 = 5/7"}},{"text":"Çıkarırken de payları çıkarırız: 6/9 − 2/9 = 4/9.","visual":{"kind":"text","text":"6/9 − 2/9 = 4/9"}}],"id":"MAT.4.1.11/L1"}],"cards":[{"type":"gen","gen":"fraction_add_same","params":{},"id":"MAT.4.1.11#1"},{"type":"gen","gen":"fraction_add_same","params":{},"id":"MAT.4.1.11#2"},{"type":"gen","gen":"fraction_add_same","params":{"d_max":8},"id":"MAT.4.1.11#3"},{"type":"mc","prompt":"3/5 + 2/5 kaç eder?","options":["5/5, yani 1 bütün","5/10","1/5"],"answer":0,"id":"MAT.4.1.11#4"}]},{"kod":"MAT.4.1.12","lessons":[{"title":"Kesir problemleri","pages":[{"text":"Pastanın 2/8'ini Ali, 3/8'ini Ayşe yedi. Toplam 5/8'ini yediler; geriye 3/8 kaldı.","visual":{"kind":"fraction","parts":8,"shaded":5}}],"id":"MAT.4.1.12/L1"}],"cards":[{"type":"mc","prompt":"Bir pizzanın 3/8'ini sen, 2/8'ini kardeşin yedi. Toplam ne kadarını yediniz?","options":["5/8","5/16","1/8"],"answer":0,"visual":{"kind":"fraction","parts":8,"shaded":5},"id":"MAT.4.1.12#1"},{"type":"mc","prompt":"Bir şişe suyun 4/6'sını içtim. Ne kadarı kaldı?","options":["2/6","4/6","1/6"],"answer":0,"id":"MAT.4.1.12#2"},{"type":"mc","prompt":"Bir yolun 2/5'ini sabah, 1/5'ini öğlen yürüdüm. Ne kadarı kaldı?","options":["2/5","3/5","1/5"],"answer":0,"id":"MAT.4.1.12#3"}]},{"kod":"MAT.4.1.13","lessons":[{"title":"Birim dönüşümleri","pages":[{"text":"km → m → cm: 1 km = 1000 m, 1 m = 100 cm. Büyük birimden küçüğe geçerken çarparız.","visual":{"kind":"text","text":"× 1000   × 100"}},{"text":"kg → g: 1 kg = 1000 g. Küçükten büyüğe geçerken böleriz: 3000 g = 3 kg.","visual":{"kind":"text","text":"3000 g ÷ 1000 = 3 kg"}}],"id":"MAT.4.1.13/L1"}],"cards":[{"type":"gen","gen":"unit_convert","params":{"kinds":