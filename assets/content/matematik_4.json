 + 230 = 322.","visual":{"kind":"text","text":"23 × 14 = 322"}},{"text":"Bölmenin sağlaması: bölüm × bölen + kalan = bölünen.","visual":{"kind":"text","text":"17 ÷ 5 = 3 kalan 2 → 3 × 5 + 2 = 17"}}],"id":"MAT.4.2.5/L1"}],"cards":[{"type":"gen","gen":"multiply","params":{"a_min":10,"a_max":99,"b_min":2,"b_max":9},"id":"MAT.4.2.5#bd62202b"},{"type":"gen","gen":"multiply","params":{"a_min":11,"a_max":50,"b_min":11,"b_max":20},"id":"MAT.4.2.5#4bcd599f"},{"type":"gen","gen":"divide","params":{"q_max":50,"d_max":9},"id":"MAT.4.2.5#fadcd8d3"},{"type":"mc","prompt":"17 ÷ 5 işleminde kalan kaçtır?","options":["2","3","5"],"answer":0,"id":"MAT.4.2.5#974f2285"}]},{"kod":"MAT.4.2.6","lessons":[{"title":"Yönerge oluştur","pages":[{"text":"“Sayıyı 2 ile çarp, 5 çıkar” gibi yönergeler bir işlem makinesine benzer.","visual":{"kind":"text","text":"⚙️ × 2 − 5"}}],"id":"MAT.4.2.6/L1"}],"cards":[{"type":"mc","prompt":"Makine: “3 ile çarp, sonra 4 çıkar”. 6 girerse ne çıkar?","options":["14","22","10"],"answer":0,"id":"MAT.4.2.6#b9e57ecc"},{"type":"mc","prompt":"Makine: “10 ekle, sonra 2'ye böl”. 20 girerse ne çıkar?","options":["15","20","12"],"answer":0,"id":"MAT.4.2.6#b34294f8"},{"type":"mc","prompt":"5 girince 15, 7 girince 21 çıkan makinenin kuralı nedir?","options":["3 ile çarp","10 ekle","14 ekle"],"answer":0,"id":"MAT.4.2.6#9393d5ba"}]},{"kod":"MAT.4.2.7","lessons":[{"title":"Dört işlem problemleri","pages":[{"text":"Bazı problemler iki adımlıdır: önce bir işlem, sonra başka bir işlem gerekir.","visual":{"kind":"text","text":"1️⃣ ➜ 2️⃣"}}],"id":"MAT.4.2.7/L1"}],"cards":[{"type":"gen","gen":"word_mul_div","params":{"max":12},"id":"MAT.4.2.7#bd71ceb8"},{"type":"gen","gen":"word_mul_div","params":{"max":12},"id":"MAT.4.2.7#bd71ceb8-2"},{"type":"mc","prompt":"Tanesi 25 TL olan 3 defter alıp 100 TL verdim. Kaç TL para üstü alırım?","options":["25 TL","75 TL","50 TL"],"answer":0,"id":"MAT.4.2.7#00e61a18"},{"type":"mc","prompt":"Bir çiftlikte 120 tavuk var. Bunların yarısı beyaz. Kaç t