{"ders":"matematik","sinif":3,"outcomes":[{"kod":"MAT.3.1.1","lessons":[{"title":"1000'e kadar sayılar","pages":[{"text":"10 onluk bir yüzlük eder. Yüzlükler, onluklar ve birliklerle 1000'e kadar sayabiliriz.","visual":{"kind":"text","text":"10 × 10 = 100"}},{"text":"3 yüzlük, 4 onluk ve 5 birlik 345 eder: üç yüz kırk beş.","visual":{"kind":"text","text":"345 = üç yüz kırk beş"}}],"id":"MAT.3.1.1/L1"}],"cards":[{"type":"gen","gen":"number_words","params":{"min":100,"max":999},"id":"MAT.3.1.1#1"},{"type":"gen","gen":"number_words","params":{"min":100,"max":1000},"id":"MAT.3.1.1#2"},{"type":"mc","prompt":"Hangisi “yedi yüz altı”dır?","options":["760","706","7006"],"answer":1,"say":"Hangisi yedi yüz altı?","id":"MAT.3.1.1#3"},{"type":"mc","prompt":"4 yüzlük, 2 onluk ve 9 birlik kaç eder?","options":["429","492","4209"],"answer":0,"id":"MAT.3.1.1#4"},{"type":"mc","prompt":"Bin sayısı nasıl yazılır?","options":["100","1000","10000"],"answer":1,"id":"MAT.3.1.1#5"}]},{"kod":"MAT.3.1.2","lessons":[{"title":"Üç basamaklı sayılar","pages":[{"text":"Üç basamaklı sayılarda soldan sağa: yüzler, onlar, birler basamağı.","visual":{"kind":"number_highlight","number":582,"pos":2}},{"text":"582 sayısında 5'in basamak değeri 500, 8'in basamak değeri 80, 2'nin basamak değeri 2'dir.","visual":{"kind":"text","text":"500 + 80 + 2 = 582"}}],"id":"MAT.3.1.2/L1"}],"cards":[{"type":"gen","gen":"place_value","params":{"digits":3},"id":"MAT.3.1.2#1"},{"type":"gen","gen":"place_value","params":{"digits":3},"id":"MAT.3.1.2#2"},{"type":"mc","prompt":"736 sayısında 7 rakamının basamak değeri kaçtır?","options":["7","70","700"],"answer":2,"id":"MAT.3.1.2#3"},{"type":"mc","prompt":"900 + 40 + 1 kaç eder?","options":["941","9401","914"],"answer":0,"id":"MAT.3.1.2#4"},{"type":"mc","prompt":"608 sayısında onlar basamağındaki rakam hangisi?","options":["6","0","8"],"answer":1,"id":"MAT.3.1.2#5"}]},{"kod":"MAT.3.1.3","lessons":[{"title":"Sıralama ve yuvarlama","pages":[{"text":"Üç basamaklı sayıları karşılaştırırken önce yüzlere, sonra onlara, sonra birlere bakarız.","visual":{"kind":"text","text":"482 < 491"}},{"text":"En yakın onluğa yuvarlarken birler basamağına bakarız: 5 ve üstü yukarı, 4 ve altı aşağı. 67 → 70, 63 → 60.","visual":{"kind":"text","text":"67 ≈ 70"}}],"id":"MAT.3.1.3/L1"}],"cards":[{"type":"gen","gen":"order3","params":{"max":999},"id":"MAT.3.1.3#1"},{"type":"gen","gen":"compare","params":{"max":999},"id":"MAT.3.1.3#2"},{"type":"gen","gen":"round_to","params":{"to":10,"max":999},"id":"MAT.3.1.3#3"},{"type":"gen","gen":"round_to","params":{"to":100,"max":999},"id":"MAT.3.1.3#4"},{"type":"mc","prompt":"348 sayısı hangi iki yüzlük arasındadır?","options":["200 ile 300","300 ile 400","400 ile 500"],"answer":1,"id":"MAT.3.1.3#5"}]},{"kod":"MAT.3.1.4","lessons":[{"title":"Ritmik sayma","pages":[{"text":"Altışar, yedişer, sekizer, dokuzar sayarız. Bu sayılar çarpım tablosunu da oluşturur!","visual":{"kind":"text","text":"7 · 14 · 21 · 28"}},{"text":"Onar ve yüzer de sayabiliriz: 300, 400, 500…","visual":{"kind":"text","text":"300 · 400 · 500"}}],"id":"MAT.3.1.4/L1"}],"cards":[{"type":"gen","gen":"skip_count","params":{"steps":[6]},"id":"MAT.3.1.4#1"},{"type":"gen","gen":"skip_count","params":{"steps":[7]},"id":"MAT.3.1.4#2"},{"type":"gen","gen":"skip_count","params":{"steps":[8,9]},"id":"MAT.3.1.4#3"},{"type":"gen","gen":"skip_count","params":{"steps":[100]},"id":"MAT.3.1.4#4"},{"type":"mc","prompt":"900, 800, 700, ? Sıradaki sayı hangisi?","options":["600","650","690"],"answer":0,"id":"MAT.3.1.4#5"}]},{"kod":"MAT.3.1.5","lessons":[{"title":"Tek ve çift sayılar","pages":[{"text":"İkişer eşleştirdiğimizde artan kalmıyorsa sayı çifttir. Bir tane artıyorsa tektir.","visual":{"kind":"objects","emoji":"🧦","count":7}},{"text":"Birler basamağı 0, 2, 4, 6, 8 olan sayılar çift; 1, 3, 5, 7, 9 olanlar tektir.","visual":{"kind":"text","text":"Çift: 0 2 4 6 8   Tek: 1 3 5 7 9"}}],"id":"MAT.3.1.5/L1"}],"cards":[{"type":"gen","gen":"odd_even","params":{"max":100},"id":"MAT.3.1.5#1"},{"type":"gen","gen":"odd_even","params":{"max":1000},"id":"MAT.3.1.5#2"},{"type":"mc","prompt":"Hangisi çift sayıdır?","options":["35","48","71"],"answer":1,"id":"MAT.3.1.5#3"},{"type":"mc","prompt":"Hangisi tek sayıdır?","options":["120","246","357"],"answer":2,"id":"MAT.3.1.5#4"}]},{"kod":"MAT.3.1.6","lessons":[{"title":"Tek + çift = ?","pages":[{"text":"İki çift sayının toplamı çifttir: 4 + 6 = 10.","visual":{"kind":"text","text":"çift + çift = çift"}},{"text":"İki tek sayının toplamı da çifttir: 3 + 5 = 8. Tek ile çiftin toplamı tektir: 3 + 4 = 7.","visual":{"kind":"text","text":"tek + tek = çift · tek + çift = tek"}}],"id":"MAT.3.1.6/L1"}],"cards":[{"type":"gen","gen":"odd_even_sum","params":{"max":50},"id":"MAT.3.1.6#1"},{"type":"gen","gen":"odd_even_sum","params":{"max":500},"id":"MAT.3.1.6#2"},{"type":"mc","prompt":"Tek + tek toplamı ne olur?","options":["Her zaman tek","Her zaman çift","Bazen tek, bazen çift"],"answer":1,"id":"MAT.3.1.6#3"},{"type":"mc","prompt":"Tek + çift toplamı ne olur?","options":["Her zaman tek","Her zaman çift"],"answer":0,"id":"MAT.3.1.6#4"}]},{"kod":"MAT.3.1.7","lessons":[{"title":"Örüntülerde kural","pages":[{"text":"Her adımda bir sıra daha ekleniyor: 1, 3, 6, 10… Eklenen sayılar 2, 3, 4…","visual":{"kind":"text","text":"1 · 3 · 6 · 10"}},{"text":"Kuralı bulunca 5. adımı da bulabiliriz: 10 + 5 = 15.","visual":{"kind":"text","text":"10 + 5 = 15"}}],"id":"MAT.3.1.7/L1"}],"cards":[{"type":"mc","prompt":"2, 4, 8, 16, ? Sıradaki sayı hangisi?","options":["18","24","32"],"answer":2,"explain":"Her adımda sayı iki katına çıkıyor.","id":"MAT.3.1.7#1"},{"type":"mc","prompt":"1, 3, 6, 10, ? Sıradaki sayı hangisi?","options":["12","14","15"],"answer":2,"explain":"Eklenen sayılar 2, 3, 4, 5…","id":"MAT.3.1.7#2"},{"type":"mc","prompt":"5, 10, 20, 35, ? Sıradaki sayı hangisi?","options":["40","50","55"],"answer":2,"explain":"Eklenen sayılar 5, 10, 15, 20…","id":"MAT.3.1.7#3"},{"type":"gen","gen":"skip_count","params":{"steps":[6,7,8,9]},"id":"MAT.3.1.7#4"},{"type":"mc","prompt":"🔺 · 🔺🔺🔺 · 🔺🔺🔺🔺🔺 · ? Sonraki adımda kaç üçgen olur?","options":["6","7","9"],"answer":1,"id":"MAT.3.1.7#5"}]},{"kod":"MAT.3.1.8","lessons":[{"title":"100'e kadar tahmin","pages":[{"text":"Kalabalık bir grubun bir parçasını sayıp kaç parça olduğuna bakarak tahmin ederiz.","visual":{"kind":"objects","emoji":"🐟","count":60}},{"text":"Bir sırada 10 balık var, yaklaşık 6 sıra: yaklaşık 60 balık!","visual":{"kind":"objects","emoji":"🐟","count":60}}],"id":"MAT.3.1.8/L1"}],"cards":[{"type":"mc","prompt":"Saymadan tahmin et: yaklaşık kaç tane var?","options":["Yaklaşık 20","Yaklaşık 50","Yaklaşık 90"],"answer":1,"visual":{"kind":"objects","emoji":"⭐","count":52},"id":"MAT.3.1.8#1"},{"type":"mc","prompt":"Saymadan tahmin et: yaklaşık kaç tane var?","options":["Yaklaşık 30","Yaklaşık 60","Yaklaşık 100"],"answer":2,"visual":{"kind":"objects","emoji":"🌼","count":97},"id":"MAT.3.1.8#2"},{"type":"mc","prompt":"Bir otobüste yaklaşık kaç yolcu oturabilir?","options":["Yaklaşık 5","Yaklaşık 50","Yaklaşık 500"],"answer":1,"id":"MAT.3.1.8#3"}]},{"kod":"MAT.3.1.9","lessons":[{"title":"Kesirle yazmak","pages":[{"text":"Yarımı 1/2, çeyreği 1/4 diye yazarız. Bütünü 2/2 ya da 4/4 diye de yazabiliriz.","visual":{"kind":"fraction","parts":2,"shaded":1}},{"text":"1/4 demek: bütün 4 eş parçaya bölündü, 1 parçası alındı.","visual":{"kind":"fraction","parts":4,"shaded":1}}],"id":"MAT.3.1.9/L1"}],"cards":[{"type":"gen","gen":"fraction_read","params":{"parts":[2,4]},"id":"MAT.3.1.9#1"},{"type":"mc","prompt":"Yarım hangi kesirle gösterilir?","options":["1/2","1/4","2/1"],"answer":0,"id":"MAT.3.1.9#2"},{"type":"mc","prompt":"Çeyrek hangi kesirle gösterilir?","options":["1/2","1/4","4/1"],"answer":1,"id":"MAT.3.1.9#3"},{"type":"mc","prompt":"4/4 neye eşittir?","options":["Bir bütün","Yarım","Çeyrek"],"answer":0,"visual":{"kind":"fraction","parts":4,"shaded":4},"id":"MAT.3.1.9#4"}]},{"kod":"MAT.3.1.10","lessons":[{"title":"Birim kesirler","pages":[{"tex