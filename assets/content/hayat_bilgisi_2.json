{"ders":"hayat_bilgisi","sinif":2,"outcomes":[{"kod":"HB.2.1.1","lessons":[{"title":"Planlı olmak","pages":[{"text":"Günümüzü planlarsak işlerimizi zamanında bitirir, oyuna da vakit buluruz.","visual":{"kind":"text","text":"📅 ✅"}},{"text":"Okul çantamızı akşamdan hazırlamak sabah işimizi kolaylaştırır.","visual":{"kind":"emoji","emoji":"🎒"}}],"id":"HB.2.1.1/L1"}],"cards":[{"type":"mc","prompt":"Okul çantanı ne zaman hazırlamak daha iyidir?","options":["Akşamdan","Sabah servise binerken"],"answer":0,"id":"HB.2.1.1#1"},{"type":"mc","prompt":"Planlı olmak bize ne kazandırır?","options":["İşlerimizi zamanında bitiririz","Her şeyi unuturuz"],"answer":0,"id":"HB.2.1.1#2"},{"type":"act","prompt":"Ailenle yarının planını yap: ödev, oyun ve uyku saatlerini birlikte yazın.","id":"HB.2.1.1#3"}]},{"kod":"HB.2.1.2","lessons":[{"title":"Güzel iletişim","pages":[{"text":"Konuşurken karşımızdakinin gözlerine bakar, sözünü kesmeden dinleriz.","visual":{"kind":"text","text":"👀 👂"}},{"text":"Kızgın olsak bile kırıcı sözler söylemeyiz; duygumuzu sakin anlatırız: “Buna üzüldüm.”","visual":{"kind":"emoji","emoji":"🗣️"}}],"id":"HB.2.1.2/L1"}],"cards":[{"type":"mc","prompt":"Arkadaşın konuşurken ne yaparsın?","options":["Dinlerim","Sözünü keserim","Başka şeyle ilgilenirim"],"answer":0,"id":"HB.2.1.2#1"},{"type":"mc","prompt":"Bir şeye üzüldüğünde nasıl söylersin?","options":["“Buna üzüldüm” derim","Bağırırım","Kapıyı çarparım"],"answer":0,"id":"HB.2.1.2#2"},{"type":"mc","prompt":"Öğretmenine bir şey sorarken nasıl başlarsın?","options":["“Öğretmenim, sorabilir miyim?”","“Hey sen!”"],"answer":0,"id":"HB.2.1.2#3"}]},{"kod":"HB.2.1.3","lessons":[{"title":"Arkadaşlık","pages":[{"text":"İyi arkadaş paylaşır, yardım eder ve sözünü tutar.","visual":{"kind":"text","text":"🤝 🍪"}},{"text":"Arkadaşımızla anlaşamazsak konuşarak çözüm buluruz.","visual":{"kind":"emoji","emoji":"💬"}}],"id":"HB.2.1.3/L1"}],"cards":[{"type":"mc","prompt":"Arkadaşınla aynı oyuncağı istiyorsanız ne yaparsınız?","options":["