itle":"Çevremdeki sorumluluklarım","pages":[{"text":"Evde, okulda ve mahallede de sorumluluklarımız vardır: düzen, temizlik, yardımlaşma.","visual":{"kind":"text","text":"🏠 🏫 🌳"}}],"id":"HB.2.3.3/L1"}],"cards":[{"type":"mc","prompt":"Sınıfta hangisi senin sorumluluğundur?","options":["Sıramı düzenli tutmak","Okul müdürünü seçmek"],"answer":0,"id":"HB.2.3.3#1"},{"type":"mc","prompt":"Mahallede hangisi hepimizin sorumluluğudur?","options":["Çevreyi temiz tutmak","Duvarlara yazı yazmak"],"answer":0,"id":"HB.2.3.3#2"},{"type":"act","prompt":"Bu hafta mahallende ya da apartmanında yapabileceğin bir iyilik planlayın ve yapın.","id":"HB.2.3.3#3"}]},{"kod":"HB.2.4.1","lessons":[{"title":"Tarihî ve doğal güzellikler","pages":[{"text":"Camiler, kaleler, köprüler ve eski evler tarihî mekânlardır. Göller, şelaleler ve ormanlar doğal güzelliklerdir.","visual":{"kind":"text","text":"🕌 🏰 🌉  🏞️ 🌲"}}],"id":"HB.2.4.1/L1"}],"cards":[{"type":"mc","prompt":"Hangisi tarihî bir mekândır?","options":["Eski bir kale","Yeni bir otopark"],"answer":0,"id":"HB.2.4.1#1"},{"type":"mc","prompt":"Hangisi doğal bir güzelliktir?","options":["Şelale","Alışveriş merkezi"],"answer":0,"id":"HB.2.4.1#2"},{"type":"act","prompt":"Yaşadığınız yerdeki bir tarihî mekânı ya da doğal güzelliği ailenle birlikte araştırın veya ziyaret edin.","id":"HB.2.4.1#3"}]},{"kod":"HB.2.4.2","lessons":[{"title":"Yönetim birimleri","pages":[{"text":"Ülkemiz illere, iller ilçelere, ilçeler mahalle ve köylere ayrılır.","visual":{"kind":"text","text":"il → ilçe → mahalle/köy"}},{"text":"İli vali, ilçeyi kaymakam yönetir. Mahalle ve köyün muhtarı vardır.","visual":{"kind":"text","text":"vali · kaymakam · muhtar"}}],"id":"HB.2.4.2/L1"}],"cards":[{"type":"mc","prompt":"İli kim yönetir?","options":["Vali","Muhtar","Öğretmen"],"answer":0,"id":"HB.2.4.2#1"},{"type":"mc","prompt":"Mahallenin yöneticisi kimdir?","options":["Muhtar","Vali","Kaymakam"],"answer":0,"id":"HB.2.4.2#2"},{"type":"mc","prompt":"İlçeyi kim yönetir?","options":["Ka